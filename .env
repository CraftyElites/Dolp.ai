# Dolphine secrets — edit this file, then restart the server
# Never commit real tokens to Git (add .env to .gitignore)

# Server
PORT=3847
JWT_SECRET=change-me-to-a-long-random-string

# Optional: trigger real GitHub Actions on build
# Create a PAT with "workflow" + "repo" scopes
GITHUB_TOKEN=
# Example: youruser/your-repo
GITHUB_REPO=

# Optional: Expo access token (for EAS builds)
# https://expo.dev/accounts/[account]/settings/access-tokens
EXPO_TOKEN=
